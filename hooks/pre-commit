#!/usr/bin/env bash
# Pre-commit: the seed validation CI runs before it publishes.
#
# Mirrors the "Validate seeds" step in .github/workflows/publish.yml. A seed that
# fails to parse would otherwise reach the fleet reseed, where it breaks a live
# demo rather than a commit.
#
# The composed-frontend typecheck is deliberately NOT here: it needs the plugins
# repo checked out and composed, which is CI-scale. A slow hook is a bypassed
# hook. `git commit --no-verify` skips this; CI runs both regardless.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 - <<'PY'
import glob, json, sys

bad = []
for p in glob.glob("themes/*/seed/seed.json") + ["frontend-template/seed/seed.json"]:
    try:
        json.load(open(p))
    except Exception as err:
        bad.append(f"{p}: {err}")

for p in glob.glob("themes/*/theme.json"):
    try:
        t = json.load(open(p))
    except Exception as err:
        bad.append(f"{p}: {err}")
        continue
    if t.get("id") != p.split("/")[1]:
        bad.append(f'{p}: id is {t.get("id")!r}, directory is {p.split("/")[1]!r}')

if bad:
    print("pre-commit: seed validation failed")
    for b in bad:
        print(f"  {b}")
    sys.exit(1)
print("pre-commit: seeds and theme manifests valid")
PY
