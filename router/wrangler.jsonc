{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "premium-cms-router",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [{ "binding": "DOMAINS", "id": "1f1ac109eaff4285a8883c29cbda55f3" }],
	// The Cloudflare-for-SaaS fallback origin (router.premium-cms.com → an
	// originless 192.0.2.1 record). Custom-hostname traffic only matches the
	// zone-wide `*/*` route — never a Workers custom domain, which Cloudflare
	// would try to connect to as an origin (522). Platform hostnames pass
	// through in the worker.
	"routes": [{ "pattern": "*/*", "zone_name": "premium-cms.com" }],
}
