---
/**
 * CMS pages at the site root (/about, /size-guide, …). Route pages (home,
 * posts, products, cart, …) and the static routes below keep their own URLs;
 * /pages/<slug> still works for older links.
 */
import Base from "../layouts/Base.astro";
import { getEmDashCollection } from "../lib/emdash";
import CmsContent from "../components/CmsContent.astro";
import { ROUTE_PAGES } from "../lib/slots";

const RESERVED = new Set(["pages", "posts", "products", "cart", "checkout", "search", "category", "tag", "404", "rss.xml", "index"]);
const isRoutable = (slug: string) => !ROUTE_PAGES.has(slug) && !RESERVED.has(slug);

export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("pages");
	return entries.filter((entry) => isRoutable(entry.id)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const slug = Astro.params.slug ?? "";
const page = Astro.props.entry ?? (isRoutable(slug) ? (await getEmDashCollection("pages")).entries.find((e) => e.id === slug) : undefined);
if (!page) return Astro.redirect("/404");
// Pages designed in the page builder bring their own heading and layout.
const designed = Array.isArray(page.data.content) && page.data.content.some((b) => (b as { _type?: string })?._type === "grapesBlock");
---

<Base title={page.data.title ?? page.id} content={{ collection: "pages", id: page.data.id, slug: page.id }}>
	<article class={designed ? "page-article page-article--designed" : "page-article"}>
		{!designed && (
			<header class="page-header">
				<h1 class="page-title">{page.data.title}</h1>
			</header>
		)}
		<div class="page-content">
			<CmsContent value={page.data.content} collection="pages" entryId={page.data.id} slug={page.id} />
		</div>
	</article>
</Base>
