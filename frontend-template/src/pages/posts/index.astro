---
import Base from "../../layouts/Base.astro";
import CmsContent from "../../components/CmsContent.astro";
import { getEmDashCollection } from "../../lib/emdash";
import { byNewest, postListItemHtml } from "../../lib/cards";
import { getTermsForEntries } from "../../lib/emdash";
// Designed in the admin as the page with slug `posts` (markers filled by the theme); code is the fallback.
const { entries: pages } = await getEmDashCollection("pages", { limit: 50 });
const page = pages.find((p) => p.id === "posts");
const { entries } = await getEmDashCollection("posts");
const posts = [...entries].sort(byNewest);
const tagsByEntry = await getTermsForEntries("posts", posts.map((p) => p.data.id), "tag");
---

<Base title={page?.data.title ?? "All Posts"}>
	{page ? (
		<CmsContent value={page.data.content} collection="pages" entryId={page.data.id} slug="posts" />
	) : (
		<div class="posts-page">
			<header class="page-header">
				<h1 class="page-title">All Posts</h1>
				<p class="page-description">{posts.length} {posts.length === 1 ? "article" : "articles"}</p>
			</header>
			{posts.length === 0 ? <p class="empty">No posts yet.</p> : <div class="posts-list"><Fragment set:html={posts.map((p) => postListItemHtml(p, tagsByEntry.get(p.data.id) ?? [])).join("")} /></div>}
		</div>
	)}
</Base>
