---
import Base from "../layouts/Base.astro";
import CmsContent from "../components/CmsContent.astro";
import PostCard from "../components/PostCard.astro";
import { CMS_URL } from "../config";
import { byNewest, featuredPostHtml } from "../lib/cards";
import { getEmDashCollection, getSiteSettings, getTermsForEntries } from "../lib/emdash";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const POSTS_PER_PAGE = 7;
const [{ entries: allPosts }, { entries: pages }, settings] = await Promise.all([
	getEmDashCollection("posts"),
	getEmDashCollection("pages", { limit: 50 }),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings);

// The homepage is the CMS page with slug `home` (Admin → Pages): a page-builder
// design whose markers (data-featured-post, data-posts-grid, …) the theme fills.
// Without one, the same design renders from code.
const homePage = pages.find((p) => p.id === "home");

const posts = [...allPosts].sort(byNewest);
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const gridPosts = visiblePosts.filter((p) => p !== featuredPost).slice(0, 6);
const tagsByEntry = await getTermsForEntries("posts", visiblePosts.map((p) => p.data.id), "tag");
---

<Base title={siteTitle} description={siteTagline}>
	{homePage ? (
		<CmsContent value={homePage.data.content} collection="pages" entryId={homePage.data.id} slug="home" />
	) : posts.length === 0 ? (
		<section class="empty-state">
			<h2>No posts yet</h2>
			<p>Create your first post in the admin panel.</p>
			<a href={`${CMS_URL}/_emdash/admin/content/posts/new`} class="btn">Create a post</a>
		</section>
	) : (
		<div class="home-content">
			{featuredPost && <Fragment set:html={featuredPostHtml(featuredPost, tagsByEntry.get(featuredPost.data.id) ?? [])} />}
			{gridPosts.length > 0 && (
				<section class="posts-section">
					<header class="section-header">
						<h2 class="section-title">Latest</h2>
						{hasMorePosts && <a href="/posts" class="section-link">View all</a>}
					</header>
					<div class="posts-grid">
						{gridPosts.map((post) => <PostCard post={post} tags={tagsByEntry.get(post.data.id) ?? []} />)}
					</div>
				</section>
			)}
		</div>
	)}
</Base>
