---
import Base from "../layouts/Base.astro";
import CmsContent from "../components/CmsContent.astro";
import { getEmDashCollection } from "../lib/emdash";

// Designed in the admin as the page with slug `404` (markers filled by the theme); code is the fallback.
const { entries: pages } = await getEmDashCollection("pages", { limit: 50 });
const page = pages.find((p) => p.id === "404");
---

<Base title={page?.data.title ?? "Page not found"}>
	{page ? (
		<CmsContent value={page.data.content} collection="pages" entryId={page.data.id} slug="404" />
	) : (
		<div class="not-found">
			<h1>404</h1>
			<p>The page you're looking for doesn't exist.</p>
			<a href="/">Go back home</a>
		</div>
	)}
</Base>
