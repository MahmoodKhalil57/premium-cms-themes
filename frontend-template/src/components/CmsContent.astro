---
/**
 * Portable Text content from the CMS — platform hook (static implementation).
 *
 * Renders the blocks to HTML and fills layout markers (menus, widget areas,
 * site title) inside page-builder sections. When PremiumCMS hosts this same
 * code, the platform swaps this component for one that gives signed-in
 * editors the inline editor; the `data-cms-content` wrapper is how that
 * editor finds the content on proxied GitHub Pages builds too.
 */
import type { PortableTextBlock } from "../lib/emdash";
import { getSiteSettings } from "../lib/emdash";
import { renderPortableText } from "../lib/pt";
import { fillAllSlots } from "../lib/slots";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	value: PortableTextBlock[] | undefined;
	collection: string;
	entryId: string;
	slug?: string;
	field?: string;
}

const { value, collection, entryId, slug, field = "content" } = Astro.props;
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
const html = await fillAllSlots(renderPortableText(value), { title: siteTitle, tagline: siteTagline });
---

<div data-cms-content={`${collection}:${entryId}:${field}`} data-cms-slug={slug}>
	<Fragment set:html={html} />
</div>
