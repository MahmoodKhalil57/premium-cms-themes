---
/** Post card — markup comes from lib/cards.ts (shared with the page-builder markers). */
import type { Entry, Term } from "../lib/emdash";
import { postCardHtml } from "../lib/cards";

interface Props {
	post: Entry;
	tags?: Term[];
}
const { post, tags = [] } = Astro.props;
---

<Fragment set:html={postCardHtml(post, tags)} />
