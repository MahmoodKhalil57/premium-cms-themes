{
	"$schema": "./schemas/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Bistro theme seed",
		"description": "Content-as-code for the PremiumCMS Bistro theme: menu with modifiers and kitchen stations, delivery / pickup / dine-in ordering with QR table cards, reservations, staff PINs for the POS, kitchen display and printers. Applied on every deploy (update-on-conflict)."
	},
