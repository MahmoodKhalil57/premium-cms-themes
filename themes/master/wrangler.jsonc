{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "master",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "master-db",
			"database_id": "a9a1051f-2594-4bff-b07a-99c55505154a",
		},
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "master-media" }],
	"kv_namespaces": [{ "binding": "SESSION", "id": "502cd737b6e542998e3ea6c0f26ecb46" }],
	"send_email": [{ "name": "EMAIL" }],
	"worker_loaders": [{ "binding": "LOADER" }],
	"services": [{ "binding": "SELF", "service": "master" }],
	"triggers": { "crons": ["* * * * *", "*/2 * * * *"] },
	// The agent runtime: plugins' Think agents, the browser bridge and the build sandbox, hosted here.
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [
			{ "class_name": "PluginAgent", "name": "PluginAgent" },
			{ "class_name": "BrowserBridge", "name": "BrowserBridge" },
			{ "class_name": "Sandbox", "name": "Sandbox" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PluginAgent", "BrowserBridge", "Sandbox"] },
	],
	"containers": [
		{ "class_name": "Sandbox", "image": "docker.io/cloudflare/sandbox:0.12.9", "max_instances": 5 },
	],
}
