{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apex",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Apex is a PROVISIONING-ONLY theme: it is provisioned as an instance by the
	// master control plane (like marketing), not deployed directly. So there is
	// no concrete `database_id`/KV id here — the CI's deploy step skips any theme
	// without a `database_id`, and the real bindings (D1/KV/R2/SELF/FRONTEND_ORIGIN)
	// are supplied per-instance by the projects plugin at provision time. The
	// binding names below are the contract the golden bundle expects (and back
	// `astro build` + local dev).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apex-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "apex-media",
		},
	],
	// Cloudflare Email Sending — delivers magic links, invites and notifications.
	// The sender domain must be onboarded for Email Sending (send.premium-cms.com).
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Session store (EmDash auth sessions).
	"kv_namespaces": [
		{
			"binding": "SESSION",
		},
	],
	// Cloudflare Images binding used by EmDash's image pipeline.
	"images": {
		"binding": "IMAGES",
	},
	// General maintenance plus the projects provisioning tick (see src/worker.ts).
	"triggers": {
		"crons": ["* * * * *", "*/2 * * * *"],
	},
}
