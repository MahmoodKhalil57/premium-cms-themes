{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "apex",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apex-db",
			"database_id": "4a3e3fa6-5e2b-4227-98d1-9a71427802e4",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "apex-media",
		},
	],
	// Cloudflare Email Sending — delivers magic links, invites and
	// notifications. The sender domain must be onboarded for Email Sending
	// (send.premium-cms.com already is).
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Session store (EmDash auth sessions). Declared here so `wrangler deploy`
	// reproduces the live binding set rather than dropping it.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "ecaac029607942ecaafa2f28095cd06e",
		},
	],
	// Cloudflare Images binding used by EmDash's image pipeline.
	"images": {
		"binding": "IMAGES",
	},
	"services": [{ "binding": "SELF", "service": "apex" }],
	// Static-frontend cutover: the public site is the GitHub Pages build of
	// site-apex; the Worker proxies every non-/_emdash GET/HEAD there while
	// serving the admin + REST API locally. Remove this var + redeploy to roll
	// back to EmDash's own SSR pages.
	"vars": {
		"FRONTEND_ORIGIN": "https://mahmoodkhalil57.github.io/site-apex",
	},
	// General maintenance plus the bounded Media Usage lane (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *", "*/2 * * * *"],
	},
}
