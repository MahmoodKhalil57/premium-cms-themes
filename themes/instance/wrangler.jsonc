{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "instance",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marketing-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "marketing-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// General maintenance plus the bounded Media Usage lane (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *", "*/2 * * * *"],
	},
	// The agent runtime (local dev parity; production bindings come from the deploy service).
	"ai": { "binding": "AI" },
	"durable_objects": {
		"bindings": [
			{ "class_name": "PluginAgent", "name": "PluginAgent" },
			{ "class_name": "BrowserBridge", "name": "BrowserBridge" },
			{ "class_name": "Sandbox", "name": "Sandbox" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PluginAgent", "BrowserBridge", "Sandbox"] },
	],
	"containers": [
		{ "class_name": "Sandbox", "image": "docker.io/cloudflare/sandbox:0.12.9", "max_instances": 5 },
	],
}
