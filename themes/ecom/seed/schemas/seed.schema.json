{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "premiumcms-seed-root",
	"title": "PremiumCMS seed root document",
	"description": "The root of this site's content-as-code seed. Content entries live in seed/content/<collection>/<slug>.json (one file per entry, validated by entry.schema.json); the apply script composes them into this document under `content` before applying. Applied with update-on-conflict — a living migration.",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"version": {
			"type": "string",
			"default": "1"
		},
		"meta": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"author": {
					"type": "string"
				}
			},
			"additionalProperties": true
		},
		"settings": {
			"type": "object",
			"description": "Site settings — title and tagline drive the header, footer, and /frontend-api/site.json.",
			"properties": {
				"title": {
					"$ref": "entry.schema.json#/definitions/stringOrEnv"
				},
				"tagline": {
					"$ref": "entry.schema.json#/definitions/stringOrEnv"
				}
			},
			"additionalProperties": true
		},
		"collections": {
			"type": "array",
			"description": "Collection/schema definitions. Usually omitted — instances already carry the golden schema; include only when adding collections or fields.",
			"items": {
				"type": "object",
				"required": [
					"slug"
				],
				"properties": {
					"slug": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"label": {
						"type": "string"
					},
					"labelSingular": {
						"type": "string"
					},
					"supports": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"commentsEnabled": {
						"type": "boolean"
					},
					"fields": {
						"type": "array",
						"items": {
							"type": "object"
						}
					}
				},
				"additionalProperties": true
			}
		},
		"taxonomies": {
			"type": "array",
			"items": {
				"type": "object"
			}
		},
		"bylines": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"slug",
					"displayName"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"slug": {
						"type": "string"
					},
					"displayName": {
						"type": "string"
					}
				},
				"additionalProperties": true
			}
		},
		"menus": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/menu"
			},
			"description": "Site menus (Manage → Menus). Rendered into [data-menu=\"<name>\"] markers in layout sections."
		},
		"widgetAreas": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/widgetArea"
			},
			"description": "Widget areas (Manage → Widgets). Rendered into [data-widget-area=\"<name>\"] markers."
		},
		"sections": {
			"type": "array",
			"items": {
				"$ref": "section.schema.json"
			},
			"description": "Inline sections; prefer one file per section under seed/sections/ instead — both are merged."
		},
		"redirects": {
			"type": "array",
			"items": {
				"$ref": "#/definitions/redirect"
			},
			"description": "URL redirects (Manage → Redirects), enforced by the CMS worker."
		},
		"content": {
			"type": "object",
			"description": "Inline content entries (collection → entries). Prefer one file per entry under seed/content/ instead; both are merged.",
			"additionalProperties": {
				"type": "array",
				"items": {
					"$ref": "entry.schema.json"
				}
			}
		}
	},
	"definitions": {
		"menu": {
			"type": "object",
			"required": [
				"name",
				"label",
				"items"
			],
			"properties": {
				"name": {
					"type": "string",
					"description": "Machine name — referenced by [data-menu] markers and widgets."
				},
				"label": {
					"type": "string"
				},
				"locale": {
					"type": "string"
				},
				"items": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/menuItem"
					}
				}
			},
			"additionalProperties": true
		},
		"menuItem": {
			"type": "object",
			"required": [
				"type"
			],
			"properties": {
				"type": {
					"type": "string",
					"description": "\"custom\" for URL items; a collection name for content references."
				},
				"label": {
					"type": "string"
				},
				"url": {
					"type": "string"
				},
				"ref": {
					"type": "string",
					"description": "Seed-local content id for reference items."
				},
				"collection": {
					"type": "string"
				},
				"target": {
					"enum": [
						"_blank",
						"_self"
					]
				},
				"children": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/menuItem"
					}
				}
			},
			"additionalProperties": true
		},
		"redirect": {
			"type": "object",
			"required": [
				"source",
				"destination"
			],
			"properties": {
				"source": {
					"type": "string",
					"pattern": "^/"
				},
				"destination": {
					"type": "string"
				},
				"type": {
					"enum": [
						301,
						302,
						307,
						308
					],
					"default": 301
				},
				"enabled": {
					"type": "boolean",
					"default": true
				}
			},
			"additionalProperties": true
		},
		"widgetArea": {
			"type": "object",
			"required": [
				"name",
				"label",
				"widgets"
			],
			"properties": {
				"name": {
					"type": "string",
					"description": "Machine name — referenced by [data-widget-area] markers."
				},
				"label": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"widgets": {
					"type": "array",
					"items": {
						"$ref": "#/definitions/widget"
					}
				}
			},
			"additionalProperties": false
		},
		"widget": {
			"type": "object",
			"required": [
				"type"
			],
			"properties": {
				"type": {
					"enum": [
						"content",
						"menu",
						"component"
					]
				},
				"title": {
					"type": "string"
				},
				"content": {
					"type": "array",
					"items": {
						"anyOf": [
							{
								"$ref": "entry.schema.json#/definitions/portableTextBlock"
							},
							{
								"$ref": "entry.schema.json#/definitions/htmlBlock"
							},
							{
								"$ref": "entry.schema.json#/definitions/grapesBlock"
							},
							{
								"$ref": "entry.schema.json#/definitions/otherBlock"
							}
						]
					},
					"description": "For content widgets: Portable Text."
				},
				"menuName": {
					"type": "string",
					"description": "For menu widgets: the menu's machine name."
				},
				"componentId": {
					"type": "string"
				},
				"props": {
					"type": "object"
				}
			},
			"additionalProperties": false
		}
	}
}
