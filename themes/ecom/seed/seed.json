{
	"$schema": "./schemas/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Ecom theme seed",
		"description": "Content-as-code for the PremiumCMS Ecom theme (apparel storefront). Applied on every deploy (update-on-conflict); edit the products, pages and sections in the admin or here."
	},
	"collections": [
		{
			"slug": "products",
			"label": "Products",
			"labelSingular": "Product",
			"hasSeo": true,
			"supports": [
				"drafts",
				"revisions",
				"search"
			],
			"urlPattern": "/products/{slug}",
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "price",
					"label": "Price",
					"type": "number",
					"required": true
				},
				{
					"slug": "compare_at_price",
					"label": "Compare-at price",
					"type": "number"
				},
				{
					"slug": "sku",
					"label": "SKU",
					"type": "string"
				},
				{
					"slug": "sizes",
					"label": "Sizes (comma-separated, e.g. S, M, L, XL — leave empty for one-size products)",
					"type": "string"
				},
				{
					"slug": "color",
					"label": "Color",
					"type": "string"
				},
				{
					"slug": "options",
					"label": "Options (configurable parts: choices with prices, conditions, design studio)",
					"type": "json",
					"options": {
						"schema": {
							"$schema": "http://json-schema.org/draft-07/schema#",
							"title": "Product options",
							"description": "Configurable parts of this product: each field is asked on the product page; choices can add to the price and track their own stock. Conditions show a field only when another has a value.",
							"type": "array",
							"items": {
								"type": "object",
								"title": "Field",
								"x-itemTitle": "label",
								"required": [
									"type",
									"name",
									"label"
								],
								"properties": {
									"type": {
										"type": "string",
										"title": "Type",
										"enum": [
											"text",
											"email",
											"textarea",
											"number",
											"tel",
											"url",
											"date",
											"select",
											"radio",
											"checkbox",
											"checkbox-group",
											"file",
											"hidden",
											"swatch",
											"image-choice",
											"design"
										],
										"x-enumLabels": {
											"text": "Short text",
											"textarea": "Paragraph",
											"email": "Email",
											"tel": "Phone",
											"url": "Website",
											"number": "Number",
											"date": "Date",
											"select": "Dropdown",
											"radio": "Single choice",
											"checkbox": "Checkbox",
											"checkbox-group": "Multiple choice",
											"file": "File upload",
											"hidden": "Hidden value",
											"swatch": "Colour swatches",
											"image-choice": "Picture choice",
											"design": "Design studio"
										},
										"x-ui": {
											"order": 0
										}
									},
									"label": {
										"type": "string",
										"title": "Label",
										"x-ui": {
											"order": 1
										}
									},
									"name": {
										"type": "string",
										"title": "Name",
										"description": "Key used in orders and conditions, e.g. collar",
										"x-ui": {
											"order": 2
										}
									},
									"id": {
										"type": "string",
										"title": "ID",
										"description": "Optional; defaults to the name",
										"x-ui": {
											"order": 3
										}
									},
									"required": {
										"type": "boolean",
										"title": "Required"
									},
									"width": {
										"type": "string",
										"title": "Width",
										"enum": [
											"full",
											"half"
										],
										"x-enumLabels": {
											"full": "Full width",
											"half": "Half width"
										}
									},
									"placeholder": {
										"type": "string",
										"title": "Placeholder"
									},
									"helpText": {
										"type": "string",
										"title": "Help text"
									},
									"defaultValue": {
										"type": "string",
										"title": "Default value"
									},
									"options": {
										"type": "array",
										"title": "Choices",
										"items": {
											"type": "object",
											"title": "Choice",
											"x-itemTitle": "label",
											"required": [
												"value",
												"label"
											],
											"properties": {
												"label": {
													"type": "string",
													"title": "Label",
													"x-ui": {
														"order": 0
													}
												},
												"value": {
													"type": "string",
													"title": "Value",
													"description": "Stored key — letters, numbers, dashes",
													"x-ui": {
														"order": 1
													}
												},
												"priceDelta": {
													"type": "number",
													"title": "Price added when chosen"
												},
												"color": {
													"type": "string",
													"format": "color",
													"title": "Colour (swatches)"
												},
												"image": {
													"type": "string",
													"format": "uri",
													"title": "Image URL (picture choices)"
												},
												"stock": {
													"type": "integer",
													"title": "Stock for this choice",
													"minimum": 0
												},
												"sku": {
													"type": "string",
													"title": "SKU"
												},
												"description": {
													"type": "string",
													"title": "Description"
												}
											}
										},
										"x-showWhen": {
											"field": "type",
											"in": [
												"select",
												"radio",
												"checkbox-group",
												"swatch",
												"image-choice"
											]
										}
									},
									"priceDelta": {
										"type": "number",
										"title": "Price added when filled",
										"x-showWhen": {
											"field": "type",
											"in": [
												"text",
												"textarea",
												"number",
												"checkbox",
												"file",
												"date",
												"design"
											]
										}
									},
									"validation": {
										"type": "object",
										"title": "Validation",
										"x-ui": {
											"collapsed": true
										},
										"properties": {
											"minLength": {
												"type": "integer",
												"title": "Min length",
												"minimum": 0
											},
											"maxLength": {
												"type": "integer",
												"title": "Max length",
												"minimum": 1
											},
											"min": {
												"type": "number",
												"title": "Minimum"
											},
											"max": {
												"type": "number",
												"title": "Maximum"
											},
											"pattern": {
												"type": "string",
												"title": "Pattern (regex)"
											},
											"patternMessage": {
												"type": "string",
												"title": "Pattern error message"
											},
											"accept": {
												"type": "string",
												"title": "Accepted file types"
											},
											"maxFileSize": {
												"type": "integer",
												"title": "Max file size (bytes)"
											}
										}
									},
									"condition": {
										"type": "object",
										"title": "Show only when…",
										"x-ui": {
											"collapsed": true
										},
										"properties": {
											"field": {
												"type": "string",
												"title": "Other field (name)"
											},
											"op": {
												"type": "string",
												"title": "Condition",
												"enum": [
													"eq",
													"neq",
													"in",
													"nin",
													"filled",
													"empty"
												],
												"x-enumLabels": {
													"eq": "equals",
													"neq": "does not equal",
													"in": "is one of (comma-separated)",
													"nin": "is none of (comma-separated)",
													"filled": "is filled",
													"empty": "is empty"
												}
											},
											"value": {
												"type": "string",
												"title": "Value"
											}
										}
									},
									"design": {
										"title": "Design studio",
										"type": "object",
										"description": "Print areas the customer designs on, artwork they can place, and what the studio allows.",
										"required": [
											"areas"
										],
										"properties": {
											"areas": {
												"type": "array",
												"title": "Print areas",
												"minItems": 1,
												"items": {
													"type": "object",
													"title": "Print area",
													"x-itemTitle": "label",
													"required": [
														"id",
														"label",
														"width",
														"height"
													],
													"properties": {
														"id": {
															"type": "string",
															"title": "ID",
															"description": "Short key, e.g. front",
															"x-ui": {
																"order": 0
															}
														},
														"label": {
															"type": "string",
															"title": "Label",
															"x-ui": {
																"order": 1
															}
														},
														"width": {
															"type": "integer",
															"title": "Width (design units)",
															"minimum": 1,
															"maximum": 4000
														},
														"height": {
															"type": "integer",
															"title": "Height (design units)",
															"minimum": 1,
															"maximum": 4000
														},
														"previewImage": {
															"type": "string",
															"format": "uri",
															"title": "Mockup image URL",
															"description": "Garment photo shown under the print area"
														},
														"printBox": {
															"type": "object",
															"title": "Print box on the mockup (%)",
															"x-ui": {
																"collapsed": false
															},
															"properties": {
																"x": {
																	"type": "number",
																	"title": "Left %",
																	"minimum": 0,
																	"maximum": 100
																},
																"y": {
																	"type": "number",
																	"title": "Top %",
																	"minimum": 0,
																	"maximum": 100
																},
																"w": {
																	"type": "number",
																	"title": "Width %",
																	"minimum": 1,
																	"maximum": 100
																},
																"h": {
																	"type": "number",
																	"title": "Height %",
																	"minimum": 1,
																	"maximum": 100
																}
															}
														}
													}
												}
											},
											"presets": {
												"type": "array",
												"title": "Preset artwork",
												"items": {
													"type": "object",
													"title": "Artwork",
													"x-itemTitle": "label",
													"required": [
														"id",
														"label",
														"image"
													],
													"properties": {
														"id": {
															"type": "string",
															"title": "ID"
														},
														"label": {
															"type": "string",
															"title": "Label"
														},
														"image": {
															"type": "string",
															"format": "uri",
															"title": "Image URL"
														},
														"priceDelta": {
															"type": "number",
															"title": "Price added when used"
														}
													}
												}
											},
											"allowText": {
												"type": "boolean",
												"title": "Allow text",
												"default": true
											},
											"allowUpload": {
												"type": "boolean",
												"title": "Allow customer images",
												"default": true
											},
											"allowShapes": {
												"type": "boolean",
												"title": "Allow shapes",
												"default": true
											},
											"fonts": {
												"type": "array",
												"title": "Fonts",
												"items": {
													"type": "string"
												},
												"x-ui": {
													"widget": "chips",
													"placeholder": "Inter, Arial, Impact…"
												}
											},
											"colors": {
												"type": "array",
												"title": "Colour swatches",
												"items": {
													"type": "string"
												},
												"x-ui": {
													"widget": "chips",
													"placeholder": "#111111, #ffffff…"
												}
											},
											"maxLayers": {
												"type": "integer",
												"title": "Max layers",
												"minimum": 1,
												"maximum": 12
											},
											"uploadMaxBytes": {
												"type": "integer",
												"title": "Max upload size (bytes)",
												"minimum": 1
											},
											"textPriceDelta": {
												"type": "number",
												"title": "Price added for text"
											},
											"uploadPriceDelta": {
												"type": "number",
												"title": "Price added for a customer image"
											}
										},
										"x-showWhen": {
											"field": "type",
											"equals": "design"
										},
										"x-ui": {
											"collapsed": false
										}
									}
								}
							}
						}
					}
				},
				{
					"slug": "stock",
					"label": "Stock (blank = unlimited)",
					"type": "integer"
				},
				{
					"slug": "image",
					"label": "Image",
					"type": "image"
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "requires_shipping",
					"label": "Requires shipping",
					"type": "boolean",
					"defaultValue": true
				},
				{
					"slug": "featured",
					"label": "Featured",
					"type": "boolean"
				}
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary",
			"items": [
				{
					"type": "custom",
					"label": "Shop",
					"url": "/products"
				},
				{
					"type": "custom",
					"label": "Size guide",
					"url": "/size-guide"
				},
				{
					"type": "custom",
					"label": "Shipping & returns",
					"url": "/shipping-returns"
				},
				{
					"type": "custom",
					"label": "About",
					"url": "/about"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/admin",
			"destination": "/_emdash/admin",
			"type": 302
		}
	],
	"widgetAreas": [
		{
			"name": "footer",
			"label": "Footer widgets",
			"description": "Rendered in the footer's help column.",
			"widgets": [
				{
					"type": "content",
					"title": "Help",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Free shipping on orders over $75. 30-day returns on unworn items. Questions? Reply to your order email and we'll sort it out."
								}
							]
						}
					]
				}
			]
		}
	],
	"content": {},
	"retire": [
		"products/studio-tee",
		"products/sticker-pack",
		"products/digital-guide",
		"pages/posts"
	]
}
